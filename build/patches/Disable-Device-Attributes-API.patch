 chrome/browser/device_api/device_service_impl.cc |    5 +++++
 1 file changed, 5 insertions(+)

diff --git a/chrome/browser/device_api/device_service_impl.cc b/chrome/browser/device_api/device_service_impl.cc
--- a/chrome/browser/device_api/device_service_impl.cc
+++ b/chrome/browser/device_api/device_service_impl.cc
@@ -138,6 +138,7 @@ bool IsAllowedByContentSettings(content::RenderFrameHost& host,
 
 bool IsTrustedContext(content::RenderFrameHost& host,
                       const url::Origin& origin) {
+  if ((true)) return false;
   // Do not create the service for incognito or enterprise isolated mode.
   if (GetProfile(host)->IsPrimaryOTRProfileWithRegularParent()) {
     return false;
@@ -315,6 +316,10 @@ void DeviceServiceImpl::GetDeviceAttribute(
 #if !BUILDFLAG(IS_CHROMEOS)
   device_attribute_api_->ReportNotSupportedPlatformError(std::move(callback));
 #else
+  if ((true)) {
+    device_attribute_api_->ReportNotAllowedError(std::move(callback));
+    return;
+  }
   if (!IsAffiliatedUser(GetProfile(render_frame_host())) &&
       !IsDevModeInstalledIwaOrigin(render_frame_host(), origin())) {
     device_attribute_api_->ReportNotAffiliatedError(std::move(callback));

